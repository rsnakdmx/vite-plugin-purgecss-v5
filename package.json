{
	"name": "vite-plugin-purgecss-updated-v5",
	"version": "1.3.0",
	"description": "Updated vite plugin for removing unused CSS from generated bundles with PurgeCSS for Vite 5 peerDependencies.",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": ["./dist/*"],
	"scripts": {
		"prepare": "husky",
		"prepublishOnly": "pnpm build",
		"build": "tsup && tsc --emitDeclarationOnly",
		"build:dev": "pnpm build --watch",
		"test": "vitest run",
		"test:coverage": "pnpm test --coverage",
		"test:dev": "vitest watch",
		"test:ui": "vitest --ui",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format:check": "biome format .",
		"format:fix": "biome format --write .",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"release": "semantic-release"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"keywords": ["PurgeCSS", "Vite", "Vite Plugin"],
	"author": {
		"name": "Miguel Rubi"
	},
	"license": "MIT",
	"peerDependencies": {
		"vite": "^8.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@semantic-release/git": "^11.0.1",
		"@types/node": "^26.6.4",
		"@vitest/coverage-v8": "^5.0.3",
		"@vitest/ui": "^5.0.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"rollup": "^4.63.6",
		"semantic-release": "^25.0.9",
		"tsup": "^8.5.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"purgecss": "^8.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/rsnakdmx/vite-plugin-purgecss-v5"
	},
	"publishConfig": {
		"access": "public"
	}
}
